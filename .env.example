# ---- FlowPilot Panel configuration ----
# Copy this file to ".env" and fill in your own values. Never commit .env.
# Port the panel listens on
PORT=3200

# ---- Meta WhatsApp Cloud API ----
# Access token from Meta App Dashboard > WhatsApp > API Setup
# (temporary token works for testing; use a System User token for production)
META_ACCESS_TOKEN=
# The phone_number_id of your WhatsApp number (test number id works)
WA_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WABA) — needed to list/sync templates
WA_BUSINESS_ACCOUNT_ID=
# Any string you choose; must match the "Verify token" you enter in Meta webhook setup
WEBHOOK_VERIFY_TOKEN=flowpilot-verify-me

# ---- AI auto-reply brain (optional) ----
# Groq API key. If empty, auto-reply uses QA rules + a polite default line only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
